# Decision backend: typesafe | zen | openrouter | cygnet | decider.
# The first three are remote System One endpoints; cygnet and decider are the
# local llama.cpp readouts, one per wire format.
DECISION_PROVIDER=zen
# Required — the model the provider serves. e.g. jev-latest (typesafe),
# inception/mercury-decide:free (openrouter), cygnet-12b, decider-4b-v2.
DECISION_MODEL=jev-1.13-free
# Endpoint base override; defaults per provider, loopback for the local readouts.
DECISION_BASE_URL=
# Free Zen models and loopback endpoints need no key.
DECISION_API_KEY=

# TYPE_TEXT helper: zen | openrouter | local. Zen free models need no key;
# local needs TEXT_BASE_URL (a loopback OpenAI-compatible endpoint).
TEXT_PROVIDER=zen
TEXT_MODEL=space-bunny-free
TEXT_BASE_URL=
TEXT_API_KEY=
# Set to "off" for helpers that reject response_format; output is still JSON-validated.
TEXT_JSON_MODE=on
TEXT_REASONING=none
